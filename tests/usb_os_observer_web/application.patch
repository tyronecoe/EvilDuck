+// BEGIN USB OBSERVER MANUAL EXPORT — no polling, capture controls or password storage.
+let usbObservationPending=false;
+async function viewUsbObservations(download){
+ const out=document.getElementById('usbObserverResult');if(!out||usbObservationPending)return;
+ usbObservationPending=true;
+ try{
+  const r=await controlFetch('/routeb/usb-observations',{headers:duckHeaders()});
+  if(!r.ok)throw new Error(httpFailure(r,await r.text()));
+  const text=await r.text();
+  if(!r.contentType.toLowerCase().startsWith('application/json'))throw new Error('Wrong response type');
+  const s=JSON.parse(text);
+  if(s.schema!=='evilduck-usb-observer-v1'||s.stage!=='CAPTURE_ONLY'||s.classification!=='UNKNOWN'||s.classificationReason!=='NO_VALIDATED_RULE'||!Number.isInteger(s.unsupported)||s.unsupported<0||s.unsupported>4294967295||!Number.isInteger(s.unsupportedReasons)||s.unsupportedReasons<0||s.unsupportedReasons>7||((s.unsupported===0)!==(s.unsupportedReasons===0))||!Array.isArray(s.records)||s.records.length>64||s.count!==s.records.length)throw new Error('Invalid capture-only response');
+  out.textContent=JSON.stringify(s,null,2);
+  if(download){const link=document.createElement('a');link.href=URL.createObjectURL(new Blob([text],{type:'application/json'}));link.download='evilduck-usb-observations.json';link.click();setTimeout(()=>URL.revokeObjectURL(link.href),1000);}
+ }catch(e){out.textContent='USB observations unavailable: '+e.message+'; no automatic retry.';}
+ finally{usbObservationPending=false;}
+}
+// END USB OBSERVER MANUAL EXPORT
