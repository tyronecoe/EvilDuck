+  }catch(e){stopMessage('STOP not confirmed: '+e.message+' Deliberate retry available.');}
+  finally{stopInFlight=false;}
+}
+function observeStop(s){
+  if(!stopReceipt)return;
+  if(stopReceipt.engine==='legacy'){if(!s.running)stopMessage('Legacy idle observed; cancellation correlation and host release are not proven.');return;}
+  if(!stopReceipt.wasOwned)return;
+  if(s.snapshotKind!=='request-capture'||s.routeBRequestId!==stopReceipt.requestId)return;
+  if(s.routeBPhase===8){stopMessage('STOP unresolved: execution quarantined. Inspect diagnostics.');return;}
+  if(s.routeBPhase===0&&s.routeBOwned===false){
+    stopMessage(s.routeBReason===2?'Stopped / Cancelled — local owner terminal. Host key release is not proven.':'Execution ended with reason '+s.routeBReason+'; cancellation was not confirmed.');
   }
 }
+async function runScript(name){
+  if(runInFlight){log('Run already pending; duplicate not submitted.');return;}
