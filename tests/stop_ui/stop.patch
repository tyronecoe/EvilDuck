+let stopInFlight=false, stopReceipt=null, runInFlight=false;
+function stopMessage(text){document.getElementById('stopResult').textContent=text;}
+async function controlFetch(url,options){
+  const controller=typeof AbortController==='undefined'?null:new AbortController();
+  if(controller)options.signal=controller.signal;
+  let timer;try{return await Promise.race([fetch(url,options),new Promise((_,reject)=>{timer=setTimeout(()=>{if(controller)controller.abort();reject(new Error('Request timed out; outcome unknown. Check status before a deliberate retry.'));},4000);})]);}
+  finally{clearTimeout(timer);}
+}
+async function stopScript(){
+  if(stopInFlight)return;
+  stopInFlight=true;stopReceipt=null;stopMessage('Requesting STOP…');
+  try{const r=await controlFetch('/stop',{method:'POST',headers:duckHeaders()});
+    if(r.status!==202)throw new Error('HTTP '+r.status+': '+await r.text());
+    const receipt=await r.json();stopReceipt=receipt;
