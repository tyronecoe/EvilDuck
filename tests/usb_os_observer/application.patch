+ uint32_t generation=0,resets=0,unplugs=0,ignored=0,observed=0,windowStartedMs=0,windowFinishedMs=0,unsupported=0;
+ uint8_t count=0,port=0,speed=0,unsupportedReasons=0;
+ bool windowStarted=false,windowClosed=false,configured=false,overflow=false,exhausted=false,clockError=false,missingReset=false;
