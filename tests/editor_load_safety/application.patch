+async function loadScript(forcedName,forcedStorage){
+ const id=editorIdentity(forcedName===undefined?document.getElementById('editorName').value:forcedName,forcedStorage===undefined?document.getElementById('editorStorage').value:forcedStorage);
+ if(!editorMayReplace())return false;
+ if(!id){editorRemember();editorCancelRead();editorState.phase='identity-changed';editorRender('Invalid script target. Source retained; no load or write sent.');return false;}
+ editorRemember();editorCancelRead();const generation=editorState.generation;
+ const controller=typeof AbortController==='undefined'?null:new AbortController();editorState.controller=controller;
+ editorState.failedTarget=id;editorState.phase='loading';editorSetFields(id);
+ editorRender('Loading '+id.name+'. Previous source is retained and locked; Save/Run are unavailable.');
+ let timer;
+ try{
+  const text=await Promise.race([fetchScriptContent(id.name,controller?controller.signal:undefined),new Promise((_,reject)=>{timer=setTimeout(()=>{if(controller)controller.abort();reject(new Error('Load timed out. No source accepted; deliberate retry available.'));},4000);})]);
