+// BEGIN EDITOR DOCUMENT SAFETY — local identity/revision, not a server version.
+const editorState={phase:'none',generation:0,revision:0,document:null,retained:null,failedTarget:null,controller:null,writing:false};
+function editorIdentity(raw,storage){
+ let path=String(raw).trim(),volume=storage==='sd'?'sd':'spiffs';
+ if(path.startsWith('sd:')||path.startsWith('SD:')){volume='sd';path=path.slice(3);}
+ else if(path.startsWith('/sd/')||path.startsWith('sd/')){volume='sd';path=path.replace(/^\/?sd\//,'');}
+ path=path.replace(/^\/+/, '');
+ if(!/^[A-Za-z0-9_.\/-]+\.(txt|duck)$/.test(path)||path.includes('..')||path.split('/').some(p=>!p||p==='.'))return null;
+ return {key:volume+':/'+path,storage:volume,path,name:(volume==='sd'?'sd:':'')+path};
+}
+function editorFields(){return editorIdentity(document.getElementById('editorName').value,document.getElementById('editorStorage').value);}
+function editorSetFields(id){document.getElementById('editorName').value=id.name;document.getElementById('editorStorage').value=id.storage;}
+function editorEligible(){
+ const id=editorFields(),doc=editorState.document;
+ return !!doc&&!!id&&id.key===doc.id.key&&['loaded','dirty','new'].includes(editorState.phase);
+}
+function editorRender(message){
+ const eligible=editorEligible()&&!editorState.writing;
+ document.getElementById('editorSave').disabled=!eligible;
+ document.getElementById('editorRun').disabled=!eligible;
+ document.getElementById('editorBody').readOnly=!['loaded','dirty','new'].includes(editorState.phase)||editorState.writing;
+ document.getElementById('editorNew').disabled=editorState.writing;
+ document.getElementById('editorLoad').disabled=editorState.writing;
+ document.getElementById('editorRetry').hidden=editorState.phase!=='load-failed'||!editorState.failedTarget;
+ document.getElementById('editorRetry').disabled=editorState.writing;
+ document.getElementById('editorRestore').hidden=!editorState.retained;
+ document.getElementById('editorRestore').disabled=editorState.writing;
+ const status=document.getElementById('editorStatus');status.dataset.state=editorState.phase;
+ if(message)status.textContent=message;
+}
+function editorRemember(){
+ if(editorState.retained)return;
+ const doc=editorState.document;if(!doc)return;
+ editorState.retained={id:{...doc.id},savedText:doc.savedText,origin:doc.origin,text:document.getElementById('editorBody').value};
+}
+function editorCancelRead(){
+ ++editorState.generation;
+ if(editorState.controller)editorState.controller.abort();
+ editorState.controller=null;
+}
+function editorHasEdits(){
+ const old=editorState.retained,doc=editorState.document;
+ return old?(old.origin==='new'||old.text!==old.savedText):!!doc&&(doc.origin==='new'||document.getElementById('editorBody').value!==doc.savedText);
+}
+function editorMayReplace(){
+ if(editorState.writing){editorRender('A Save is pending. No selection change or duplicate action was sent.');return false;}
+ if(editorHasEdits()&&!confirm('Replace unsaved editor changes if this action succeeds? Cancel keeps your draft.')){
+  if(editorState.retained)restoreEditorDraft();
+  editorRender('Unsaved draft and its original identity retained; pending replacement cancelled.');return false;
+ }
+ return true;
+}
+function editorSourceChanged(){
+ ++editorState.revision;
+ const doc=editorState.document;
+ if(doc&&['loaded','dirty','new'].includes(editorState.phase))editorState.phase=doc.origin==='new'?'new':(document.getElementById('editorBody').value===doc.savedText?'loaded':'dirty');
+ editorRender('Editor changed locally. Save and Run require this document identity; no action sent.');
+}
+function editorSelectionChanged(){
+ ++editorState.revision;editorCancelRead();
+ const id=editorFields(),doc=editorState.document;
+ if(doc&&doc.origin==='new'&&editorState.phase==='new'){
+  if(id)doc.id=id;
+  editorRender('Intentional new script: choose its target, then explicitly Save. Existing server files have no version protection.');return;
+ }
+ editorRemember();editorState.phase='identity-changed';editorState.failedTarget=null;
+ editorRender('Target changed. Load it or choose New; retained source cannot be saved under a different identity.');
+}
+function restoreEditorDraft(){
+ if(editorState.writing||!editorState.retained)return false;
+ const old=editorState.retained;editorCancelRead();++editorState.revision;
+ editorState.document={id:{...old.id},savedText:old.savedText,origin:old.origin};
+ editorSetFields(old.id);document.getElementById('editorBody').value=old.text;
+ editorState.retained=null;editorState.failedTarget=null;
+ editorState.phase=old.origin==='new'?'new':(old.text===old.savedText?'loaded':'dirty');
+ editorRender('Restored the preserved document and its original target '+old.id.name+'. No request sent.');return true;
+}
