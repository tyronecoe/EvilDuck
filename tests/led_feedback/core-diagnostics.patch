+void tud_hid_set_report_cb(uint8_t instance,uint8_t report_id,hid_report_type_t report_type,uint8_t const* buffer,uint16_t bufsize) {
+ const uint8_t protocol=instance<CFG_TUD_HID?tud_hid_n_get_protocol(instance):255;
+ const auto keyboard=evilduck_hid_keyboard_identity();
+ const bool registered=keyboard&&tinyusb_get_device_by_report_id(1)==keyboard;
+ auto note=[&](uint8_t stage,uint8_t effective){evilduck_hid_route_diagnostic(stage,instance,report_id,uint8_t(report_type),bufsize,effective,protocol,uint8_t(tinyusb_interface_protocol),registered);};
+ note(0,report_id); // Before any instance, pointer, length or type rejection.
+ if(instance>=CFG_TUD_HID){note(4,report_id);return;}
+ if(bufsize&&!buffer){note(5,report_id);return;}
+ if((!report_id&&!report_type)||report_type==HID_REPORT_TYPE_OUTPUT){
+  if(!buffer||!bufsize){note(6,report_id);return;}
+  auto output=[&](uint8_t id,const uint8_t* p,uint16_t n){
+   note(1,id);auto device=tinyusb_get_device_by_report_id(id);
