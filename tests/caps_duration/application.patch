+let capsTrialPending=false;
+async function capsTrial(start){
+ if(capsTrialPending)return;
+ const out=document.getElementById('capsTrialResult');const ms=document.getElementById('capsDuration').value;
+ if(start&&!['0','100','250','500'].includes(ms)){out.textContent='Select a supported duration';return;}
+ if(start&&!confirm('Run ONE Caps trial from physical Caps OFF? Focus the Mac editor within five seconds.'))return;
+ capsTrialPending=true;
+ try{const fd=new FormData();if(start)fd.append('ms',ms);
